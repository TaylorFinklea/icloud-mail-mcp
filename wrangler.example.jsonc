{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icloud-mail-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Set your own hostname. Cloudflare Access must cover only /authorize on it.
  "routes": [{ "pattern": "mail-mcp.example.com", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<kv-namespace-id>" }],
  "vars": {
    "PUBLIC_ORIGIN": "https://mail-mcp.example.com",
    "ICLOUD_USER": "you@icloud.com",
    "OWNER_EMAIL": "you@example.com",
    "ACCESS_TEAM_DOMAIN": "https://<team>.cloudflareaccess.com",
    "ACCESS_AUD": "<access-application-aud-tag>",
    "ALLOWED_REDIRECT_HOSTS": "claude.ai,claude.com"
  },
  "observability": { "enabled": true }
  // ICLOUD_APP_PASSWORD is a secret: npx wrangler secret put ICLOUD_APP_PASSWORD
}
